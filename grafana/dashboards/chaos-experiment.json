{
  "id": null,
  "uid": "chaos-experiment",
  "title": "Chaos Experiment Dashboard",
  "tags": ["chaos", "platform"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-1h", "to": "now"},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {"type": "grafana", "uid": "-- Grafana --"},
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "name": "Chaos Experiments",
        "type": "tags",
        "tags": ["chaos-start", "chaos-end"]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "ALB Error Rate",
      "description": "ALB の 5xx エラー数 / リクエスト数",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "cloudwatch", "uid": "CloudWatch"},
      "targets": [
        {
          "refId": "A",
          "region": "ap-northeast-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "statistics": ["Sum"],
          "period": "60",
          "alias": "5xx Count"
        },
        {
          "refId": "B",
          "region": "ap-northeast-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "statistics": ["Sum"],
          "period": "60",
          "alias": "Request Count"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}}
    },
    {
      "id": 2,
      "title": "ALB p95 Latency (ms)",
      "description": "ALB TargetResponseTime p95",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "cloudwatch", "uid": "CloudWatch"},
      "targets": [
        {
          "refId": "A",
          "region": "ap-northeast-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "statistics": ["p95"],
          "period": "60",
          "alias": "p95 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"},
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "service-a AggregateDuration p95 (ms)",
      "description": "service-a の /aggregate エンドポイント p95 レイテンシ",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "cloudwatch", "uid": "CloudWatch"},
      "targets": [
        {
          "refId": "A",
          "region": "ap-northeast-1",
          "namespace": "ChaosExperiment",
          "metricName": "AggregateDurationMs",
          "dimensions": {"Service": "service-a"},
          "statistics": ["p95"],
          "period": "60",
          "alias": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"}
      }
    },
    {
      "id": 4,
      "title": "service-b ResponseTime p95 (ms)",
      "description": "service-b の /data エンドポイント p95 レイテンシ",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "cloudwatch", "uid": "CloudWatch"},
      "targets": [
        {
          "refId": "A",
          "region": "ap-northeast-1",
          "namespace": "ChaosExperiment",
          "metricName": "ResponseTimeMs",
          "dimensions": {"Service": "service-b"},
          "statistics": ["p95"],
          "period": "60",
          "alias": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "ms"}
      }
    },
    {
      "id": 5,
      "title": "Circuit Breaker State",
      "description": "0=CLOSED (正常) / 1=OPEN (遮断中)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 16},
      "datasource": {"type": "cloudwatch", "uid": "CloudWatch"},
      "targets": [
        {
          "refId": "A",
          "region": "ap-northeast-1",
          "namespace": "ChaosExperiment",
          "metricName": "CircuitBreakerState",
          "dimensions": {"Service": "service-a"},
          "statistics": ["Maximum"],
          "period": "60",
          "alias": "Circuit Breaker"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "auto",
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "CLOSED", "color": "green", "index": 0},
                "1": {"text": "OPEN",   "color": "red",   "index": 1}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red",   "value": 1}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Fallback / Stale Cache Hits",
      "description": "stale cache 発動数とフォールバック発動数",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 18, "x": 6, "y": 16},
      "datasource": {"type": "cloudwatch", "uid": "CloudWatch"},
      "targets": [
        {
          "refId": "A",
          "region": "ap-northeast-1",
          "namespace": "ChaosExperiment",
          "metricName": "FallbackCount",
          "dimensions": {"Service": "service-a"},
          "statistics": ["Sum"],
          "period": "60",
          "alias": "Fallback"
        },
        {
          "refId": "B",
          "region": "ap-northeast-1",
          "namespace": "ChaosExperiment",
          "metricName": "StaleCacheHitCount",
          "dimensions": {"Service": "service-a"},
          "statistics": ["Sum"],
          "period": "60",
          "alias": "Stale Cache Hit"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"}
      }
    },
    {
      "id": 7,
      "title": "Node CPU / Memory",
      "description": "EC2 ノードの CPU 使用率とメモリ空き率",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "Prometheus"},
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100)",
          "legendFormat": "CPU % - {{instance}}"
        },
        {
          "refId": "B",
          "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100",
          "legendFormat": "Mem Available % - {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "percent"}
      }
    },
    {
      "id": 8,
      "title": "X-Ray Service Map",
      "description": "service-a → Envoy → service-b の分散トレースグラフ",
      "type": "nodeGraph",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "grafana-x-ray-datasource", "uid": "X-Ray"},
      "targets": [
        {
          "refId": "A",
          "queryType": "getServiceMap"
        }
      ],
      "options": {}
    }
  ]
}

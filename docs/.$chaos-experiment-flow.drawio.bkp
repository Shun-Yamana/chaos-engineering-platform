      <mxGeometry x="200" y="80" width="340" height="60" as="geometry" />
    </mxCell>

    <!-- Arrow 1→2 -->
    <mxCell id="e12" value="POST /experiments" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" source="react1" target="api_handler" parent="1">
      <mxGeometry relative="1" as="geometry" />

    <!-- Arrow 5→6 -->
    <mxCell id="e56" value="ALB アクセスログ → EMF メトリクス送信" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" source="service_b" target="cloudwatch" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ===== 6. ALB + CloudWatch ===== -->
    <mxCell id="cloudwatch" value="&lt;b&gt;ALB  +  CloudWatch&lt;/b&gt;&lt;br&gt;error_rate  /  p95 latency を 1 分粒度で収集" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1">
      <mxGeometry x="200" y="702" width="340" height="60" as="geometry" />
    </mxCell>

    <!-- ===== auto_stopper (side) ===== -->
    <mxCell id="auto_stopper" value="&lt;b&gt;auto_stopper&lt;/b&gt;&lt;br&gt;SLO 違反検知&lt;br&gt;① emergency_stop フラグを DynamoDB に書き込み&lt;br&gt;② _emergency_recover スレッド起動&lt;br&gt;　scale=0 → fault 除去 → 30s 待機 → scale back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;" vertex="1" parent="1">
      <mxGeometry x="590" y="682" width="240" height="100" as="geometry" />
    </mxCell>

    <!-- CW → auto_stopper (SLO violation) -->
    <mxCell id="e_cw_as" value="SLO 違反" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontColor=#b85450;strokeColor=#b85450;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" source="cloudwatch" target="auto_stopper" parent="1">

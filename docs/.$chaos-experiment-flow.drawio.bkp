    <!-- Arrow 2→3 -->
    <mxCell id="e23" value="put_item" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" source="api_handler" target="dynamo_pending" parent="1">

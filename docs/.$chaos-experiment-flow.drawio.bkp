      <mxGeometry x="210" y="840" width="320" height="70" as="geometry" />
    </mxCell>

    <!-- auto_stopper → dynamo_completed (writes emergency_stop) -->
    <mxCell id="e_as_db" value="emergency_stop&lt;br&gt;update_item" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=10;fontColor=#d6b656;strokeColor=#d6b656;labelBackgroundColor=#ffffff;fontStyle=2;" edge="1" source="auto_stopper" target="dynamo_completed" parent="1">

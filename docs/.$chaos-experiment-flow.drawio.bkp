    <mxCell id="chaos_agent" value="&lt;b&gt;chaos-agent  (EKS Fargate)&lt;/b&gt;&lt;br&gt;kubectl set env / scale → フォルト注入&lt;br&gt;トラフィックジェネレータ起動" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">

    <!-- Arrow 6→7 (duration経過) -->
    <mxCell id="e67" value="duration 経過後  _record_experiment(completed)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" source="cloudwatch" target="dynamo_completed" parent="1">

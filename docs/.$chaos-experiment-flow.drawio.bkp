    <!-- ===== 2. API Handler Lambda ===== -->
    <mxCell id="api_handler" value="&lt;b&gt;API Handler (Lambda)&lt;/b&gt;&lt;br&gt;put_item:  status=&lt;i&gt;pending&lt;/i&gt;, started_at=T₁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">

    <!-- Arrow 7→8 -->
    <mxCell id="e78" value="DynamoDB Streams  (5 分バッファ後にトリガー)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=11;fontColor=#555555;labelBackgroundColor=#ffffff;" edge="1" source="dynamo_completed" target="evaluator" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <!-- ===== 8. Evaluator Lambda ===== -->
    <mxCell id="evaluator" value="&lt;b&gt;Evaluator Lambda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Phase A&lt;/font&gt;: フォルト中の吸収・封じ込め（error_rate / p95）&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Phase B&lt;/font&gt;: 回復速度・TTR（offset 90〜180 s）&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;Safety Net&lt;/font&gt;: auto_stopper 発動の期待値チェック" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">

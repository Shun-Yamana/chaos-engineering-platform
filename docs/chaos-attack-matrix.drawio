        <!-- ===== 攻撃ゾーン ===== -->

        <!-- Chaos Mesh ゾーン（service-b 直撃） -->
        <mxCell id="cm_zone" parent="1" style="swimlane;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=14;startSize=35;" value="Chaos Mesh 実験（K8s コンテナ層）— service-b 直撃" vertex="1">
          <mxGeometry height="330" width="340" x="215" y="420" as="geometry" />
        </mxCell>
        <mxCell id="cm_t1" parent="cm_zone" style="text;html=1;fontStyle=1;fontSize=11;align=left;" value="▌ StressChaos / PodChaos / NetworkChaos" vertex="1">
          <mxGeometry height="18" width="320" x="8" y="42" as="geometry" />
        </mxCell>
        <mxCell id="cm_items" parent="cm_zone" style="text;html=1;align=left;fontSize=11;spacingLeft=12;" value="① pod_kill ─ Pod を強制削除（PodChaos）&lt;br&gt;② cpu_stress ─ CPU 80% 継続負荷（StressChaos）&lt;br&gt;③ memory_stress ─ 150MB 確保・OOMKill 寸前（StressChaos）&lt;br&gt;④ network_latency ─ 500ms 遅延注入（NetworkChaos）" vertex="1">
          <mxGeometry height="75" width="320" x="8" y="62" as="geometry" />
        </mxCell>
        <mxCell id="cm_t2" parent="cm_zone" style="text;html=1;fontStyle=1;fontSize=11;align=left;" value="▌ FAULT_RATE env patch（アプリ層）" vertex="1">
          <mxGeometry height="18" width="320" x="8" y="148" as="geometry" />
        </mxCell>
        <mxCell id="cm_items2" parent="cm_zone" style="text;html=1;align=left;fontSize=11;spacingLeft=12;" value="⑤ http_error_inject ─ FAULT_RATE=0.5 で 500 を 50% 返す&lt;br&gt;　 → auto_stopper が SLI 超過を検知・緊急停止（ADR 094）" vertex="1">
          <mxGeometry height="40" width="320" x="8" y="168" as="geometry" />
        </mxCell>
        <mxCell id="cm_sep" parent="cm_zone" style="line;strokeColor=#b85450;" value="" vertex="1">
          <mxGeometry height="10" width="320" x="8" y="218" as="geometry" />
        </mxCell>
        <mxCell id="cm_impact" parent="cm_zone" style="text;html=1;align=left;fontSize=11;fontColor=#b85450;fontStyle=1;spacingLeft=8;" value="⚠ 影響：service-a の SLO 劣化&lt;br&gt;→ CB 発動 + stale cache / fallback で吸収&lt;br&gt;→ StaleCacheHitCount / FallbackCount が上昇" vertex="1">
          <mxGeometry height="65" width="320" x="8" y="252" as="geometry" />
        </mxCell>

        <!-- FIS ゾーン（インフラ層） -->
        <mxCell id="fis_zone" parent="1" style="swimlane;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;startSize=35;" value="AWS FIS 実験（インフラ層）" vertex="1">
          <mxGeometry height="195" width="300" x="580" y="420" as="geometry" />
        </mxCell>
        <mxCell id="fis_t1" parent="fis_zone" style="text;html=1;fontStyle=1;fontSize=11;align=left;" value="▌ EC2 / VPC レベルの障害" vertex="1">
          <mxGeometry height="18" width="280" x="8" y="42" as="geometry" />
        </mxCell>
        <mxCell id="fis_items" parent="fis_zone" style="text;html=1;align=left;fontSize=11;spacingLeft=12;" value="⑥ node_failure ─ EC2 ノード強制終了&lt;br&gt;　 → PDB + K8s 再スケジュールで吸収&lt;br&gt;&lt;br&gt;⑦ az_isolation ─ AZ-1a をネットワーク遮断&lt;br&gt;　 → ALB が AZ-1c に自動フェイルオーバー" vertex="1">
          <mxGeometry height="80" width="280" x="8" y="62" as="geometry" />
        </mxCell>
        <mxCell id="fis_sep" parent="fis_zone" style="line;strokeColor=#9673a6;" value="" vertex="1">
          <mxGeometry height="10" width="280" x="8" y="148" as="geometry" />
        </mxCell>
        <mxCell id="fis_impact" parent="fis_zone" style="text;html=1;align=left;fontSize=11;fontColor=#9673a6;fontStyle=1;spacingLeft=8;" value="✓ 影響：一時エラー後に ALB / K8s が自動回復" vertex="1">
          <mxGeometry height="30" width="280" x="8" y="160" as="geometry" />
        </mxCell>

        <!-- Defense Evidence ゾーン -->
        <mxCell id="de_zone" parent="1" style="swimlane;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;startSize=35;" value="Defense Evidence（防衛発火証拠）ADR 095" vertex="1">
          <mxGeometry height="330" width="370" x="910" y="420" as="geometry" />
        </mxCell>
        <mxCell id="de_t1" parent="de_zone" style="text;html=1;fontStyle=1;fontSize=11;align=left;" value="▌ アプリ層（service-a EMF）" vertex="1">
          <mxGeometry height="18" width="350" x="8" y="42" as="geometry" />
        </mxCell>
        <mxCell id="de_items1" parent="de_zone" style="text;html=1;align=left;fontSize=11;spacingLeft=12;" value="StaleCacheHitCount ≥ 1 → stale cache が発動&lt;br&gt;FallbackCount ≥ 1 → fallback が発動&lt;br&gt;CircuitBreakerState = 1 → CB が開いた&lt;br&gt;FaultInjectedCount ≥ 1 → service-b が注入確認" vertex="1">
          <mxGeometry height="70" width="350" x="8" y="62" as="geometry" />
        </mxCell>
        <mxCell id="de_t2" parent="de_zone" style="text;html=1;fontStyle=1;fontSize=11;align=left;" value="▌ インフラ層（Container Insights）" vertex="1">
          <mxGeometry height="18" width="350" x="8" y="143" as="geometry" />
        </mxCell>
        <mxCell id="de_items2" parent="de_zone" style="text;html=1;align=left;fontSize=11;spacingLeft=12;" value="container_restarts_delta ≥ 1 → OOMKill 確認（memory_stress）&lt;br&gt;pod restarted → ノード障害による再スケジュール確認" vertex="1">
          <mxGeometry height="40" width="350" x="8" y="163" as="geometry" />
        </mxCell>
        <mxCell id="de_sep" parent="de_zone" style="line;strokeColor=#82b366;" value="" vertex="1">
          <mxGeometry height="10" width="350" x="8" y="213" as="geometry" />
        </mxCell>
        <mxCell id="de_note" parent="de_zone" style="text;html=1;align=left;fontSize=11;fontColor=#006600;fontStyle=1;spacingLeft=8;" value="✓ 防衛が「発動した」証拠を評価結果に記録&lt;br&gt;発動しなかった場合も FAIL にしない（informational）&lt;br&gt;例外: network_latency の stale_cache_fired は必須" vertex="1">
          <mxGeometry height="65" width="350" x="8" y="250" as="geometry" />
        </mxCell>

        <!-- X-Ray 可視化ゾーン -->
        <mxCell id="xray_zone" parent="1" style="swimlane;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;startSize=35;" value="X-Ray 可視化軸（攻撃対象による差異）" vertex="1">
          <mxGeometry height="145" width="580" x="580" y="635" as="geometry" />

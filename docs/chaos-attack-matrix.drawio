        <!-- service-d -->
        <mxCell id="svd" parent="1" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" value="&lt;b&gt;service-d&lt;/b&gt;&lt;br&gt;在庫・価格（リアルタイム）&lt;br&gt;&lt;font color=&#39;#6c8ebf&#39;&gt;&lt;i&gt;非クリティカル（CB 3回）&lt;/i&gt;&lt;/font&gt;" vertex="1">

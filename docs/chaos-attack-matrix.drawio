  <diagram id="c4yDpsz9VZJ9AK1nWXOE" name="ページ-1">
    <mxGraphModel dx="1165" dy="749" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- タイトル -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;" value="Chaos Engineering — サービストポロジーと攻撃影響マップ" vertex="1">
          <mxGeometry height="40" width="1400" x="80" y="15" as="geometry" />
        </mxCell>

        <!-- ===== サービストポロジー ===== -->

        <!-- traffic-generator -->
        <mxCell id="traffic" parent="1" style="rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" value="&lt;b&gt;traffic-generator&lt;/b&gt;&lt;br&gt;20 req/s&lt;br&gt;/aggregate/products/" vertex="1">
          <mxGeometry height="75" width="135" x="30" y="140" as="geometry" />
        </mxCell>

        <!-- service-a -->
        <mxCell id="sva" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;fontSize=13;" value="&lt;b&gt;service-a&lt;/b&gt;" vertex="1">
          <mxGeometry height="175" width="195" x="215" y="100" as="geometry" />
        </mxCell>
        <mxCell id="sva_detail" parent="1" style="text;html=1;align=left;fontSize=11;spacingLeft=6;" value="📦 /aggregate/products/{id}&lt;br&gt;🔄 asyncio.gather(b, d)&lt;br&gt;&lt;br&gt;&lt;font color=&#39;#006600&#39;&gt;防衛設計:&lt;/font&gt;&lt;br&gt;  ・Circuit Breaker (5回失敗)&lt;br&gt;  ・Stale Cache (TTL 30s)&lt;br&gt;  ・Fallback（商品名代替）" vertex="1">
          <mxGeometry height="135" width="179" x="223" y="133" as="geometry" />
        </mxCell>

        <!-- Envoy sidecar (a) -->
        <mxCell id="envoy_a" parent="1" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=11;" value="Envoy sidecar&lt;br&gt;&lt;i&gt;timeout 200ms&lt;/i&gt;&lt;br&gt;&lt;i&gt;outlier detection&lt;/i&gt;" vertex="1">
          <mxGeometry height="60" width="130" x="225" y="300" as="geometry" />
        </mxCell>

        <!-- service-b -->
        <mxCell id="svb" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;fontSize=13;" value="&lt;b&gt;service-b&lt;/b&gt;" vertex="1">
          <mxGeometry height="155" width="175" x="490" y="100" as="geometry" />
        </mxCell>
        <mxCell id="svb_detail" parent="1" style="text;html=1;align=left;fontSize=11;spacingLeft=6;" value="📦 /products/{id}&lt;br&gt;&lt;br&gt;Chaos Mesh 注入対象&lt;br&gt;（Pod / CPU / Memory / Net）&lt;br&gt;&lt;br&gt;FAULT_RATE=x.x&lt;br&gt;（http_error_inject 時）" vertex="1">
          <mxGeometry height="125" width="159" x="498" y="128" as="geometry" />
        </mxCell>

        <!-- service-c -->
        <mxCell id="svc" parent="1" style="rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=12;" value="&lt;b&gt;service-c&lt;/b&gt;&lt;br&gt;レビュー要約 / レコメンド&lt;br&gt;&lt;font color=&#39;#6c8ebf&#39;&gt;&lt;i&gt;非クリティカル（100ms timeout）&lt;/i&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="85" width="185" x="755" y="85" as="geometry" />

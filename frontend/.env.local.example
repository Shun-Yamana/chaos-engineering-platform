# ローカル開発用 — .env.local にコピーして値を埋める
# (Terraform apply 後に terraform output で確認)

# "skip" にすると Cognito 認証をバイパスしてローカル開発できる
# VITE_DEV_AUTH=skip

# Vite dev server が /experiments をプロキシする先
# ローカル開発: docker compose up した API サーバー
# VITE_DEV_API_URL=http://localhost:8080
# 本番 API Gateway に向ける場合:
VITE_DEV_API_URL=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com

# Cognito 設定
# terraform output cognito_hosted_ui_url
VITE_COGNITO_DOMAIN=https://chaos-platform-XXXXXXXXXXXX.auth.ap-northeast-1.amazoncognito.com
# terraform output cognito_client_id
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# 本番ビルド時のみ設定 (CloudFront + API Gateway)
# VITE_API_ENDPOINT=https://xxxxxxxxxx.execute-api.ap-northeast-1.amazonaws.com
